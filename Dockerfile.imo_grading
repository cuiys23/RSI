FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONUTF8=1

# MetaAgent uses bash, patch, Git, and coreutils (including timeout).
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash ca-certificates coreutils git patch \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /hyperagents
COPY requirements_imo_grading.txt ./
RUN pip install --no-cache-dir -r requirements_imo_grading.txt

# .dockerignore keeps credentials and grading data outside the image.
COPY . .
# The agent repository is bind-mounted and can be owned by the Windows host.
RUN git config --system --add safe.directory /hyperagents

CMD ["tail", "-f", "/dev/null"]
